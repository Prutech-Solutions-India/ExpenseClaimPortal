<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- `clear` first, deliberately. Without it, whatever feeds a developer or
         a runner happens to have configured at user or machine level are added
         to this project's list, which makes a restore depend on the machine it
         runs on and lets a package of the same name be resolved from a
         different feed than the one intended. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
